    "/api/upload": {
      "post": {
        "description": "Upload a P&ID diagram file\n\nAccepts: .pdf, .dwg, .dgn, .jpg, .png, .zip, .svg, .xml\nMax size: 50MB",
        "operationId": "upload_file_api_upload_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_file_api_upload_post"
