                      },
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "title": "Response List Files Api Files Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Files",
        "tags": [
          "upload"
        ]
