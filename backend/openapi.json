            "title": "Detections",
            "type": "array"
          },
          "detector": {
            "const": "template_matching",
            "default": "template_matching",
            "title": "Detector",
            "type": "string"
          },
          "image_hw": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Image Hw",
            "type": "array"
          },
          "limit_reached": {
            "title": "Limit Reached",
            "type": "boolean"
          },
