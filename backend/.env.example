# Optional for live chat, not required for upload/preview or the local QA launcher.
GROQ_API_KEY=
# Operational kill switch; false also disables the frontend chat controls.
ENABLE_CHAT=true
# Enable only with a trusted-network boundary around /metrics.
ENABLE_METRICS=false
# Optional: Sentry DSN enables error tracking; leave empty to disable it.
SENTRY_DSN=
# Origin allowed by CORS when using a non-default frontend port.
FRONTEND_URL=http://localhost:3000
# Optional: absolute path to a GraphML file for live chat context.
# GRAPHML_PATH=/absolute/path/to/graph.graphml
# Optional: defaults to backend/uploads.
# UPLOAD_DIR=/absolute/path/to/uploads
# Advanced: override only for an OpenAI-compatible provider (the QA launcher
# sets this to its loopback stub). Leave unset to use Groq.
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
