{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":disableDependencyDashboard"],
  "minimumReleaseAge": "7 days",
  "dependencyDashboard": false,
  "automerge": false,
  "enabledManagers": ["pip_requirements"],
  "includePaths": ["requirements*.in", "backend/requirements*.in"],
  "packageRules": [
    {"matchManagers": ["pip_requirements"], "groupName": "Python dependency profiles"}
  ],
  "pip_requirements": {
    "managerFilePatterns": ["/(^|/)requirements[^/]*\\.in$/"]
  }
}
